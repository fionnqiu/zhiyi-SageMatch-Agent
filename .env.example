# PostgreSQL 登录用户名。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
# PostgreSQL 服务监听端口。
POSTGRES_PORT=5432
# SageMatch 使用的 PostgreSQL 数据库名称。
POSTGRES_DB=sagematch

# 管理端访问密码；不要提交或分享真实值。
ADMIN_PASSWORD=sagematch-admin
# 当前单机匿名用户的固定标识；不构成多用户鉴权。
ANONYMOUS_USER_ID=local-user

# 兜底模型,若管理端agent角色未进行模型配置,使用兜底模型的配置
# 角色未绑定供应商时使用的兜底模型密钥。
LLM_API_KEY=
# 兜底模型的兼容 API 基础地址。
LLM_BASE_URL=
# 兜底模型名称；角色绑定的模型优先。
LLM_MODEL=
# RAG model connections (fill credentials locally; this file is gitignored).

# 是否启用向量 embedding；关闭或缺密钥时回退到词法检索。
SAGEMATCH_RAG_EMBEDDING_ENABLED=true
# 生成材料与查询向量的 embedding 模型名称。
SAGEMATCH_RAG_EMBEDDING_MODEL=
# Embedding 服务的兼容 API 基础地址。
SAGEMATCH_RAG_EMBEDDING_BASE_URL=
# Embedding 服务密钥；留空时不调用向量模型。
SAGEMATCH_RAG_EMBEDDING_API_KEY=

# 是否启用检索候选的 reranker。
SAGEMATCH_RAG_RERANK_ENABLED=true
# Reranker 模型名称。
SAGEMATCH_RAG_RERANK_MODEL=
# Reranker 服务基础地址；适配器调用其 /rerank 端点。
SAGEMATCH_RAG_RERANK_BASE_URL=
# Reranker 服务密钥；仅保存在本地 .env。
SAGEMATCH_RAG_RERANK_API_KEY=
SAGEMATCH_RAG_QUERY_REWRITE_ENABLED=true
# 查询改写使用的对话模型名称。
SAGEMATCH_RAG_QUERY_REWRITE_MODEL=
# 查询改写服务的兼容 API 基础地址。
SAGEMATCH_RAG_QUERY_REWRITE_BASE_URL=
# 查询改写服务密钥；仅保存在本地 .env。
SAGEMATCH_RAG_QUERY_REWRITE_API_KEY=
